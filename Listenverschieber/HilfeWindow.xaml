<Window x:Class="Listenverschieber.HilfeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hilfe - Listenverschieber"
        Height="720" Width="1020"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Themen" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="txtKopf" FontWeight="Bold" Margin="0,0,0,6"/>

        <DockPanel Grid.Row="1" Grid.Column="0">
            <TextBox x:Name="txtSuche" DockPanel.Dock="Top" Height="26" Margin="0,0,0,6"
                     ToolTip="Themen filtern" TextChanged="txtSuche_TextChanged"/>
            <ListBox x:Name="lstThemen" DisplayMemberPath="Titel"
                     SelectionChanged="lstThemen_SelectionChanged"/>
        </DockPanel>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="#DDDDDD"/>

        <Border Grid.Row="1" Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="1" Padding="14">
            <RichTextBox x:Name="rtbInhalt" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         BorderThickness="0" Background="Transparent" Padding="0"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
        </Border>

        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnThemaKopieren" Content="Thema kopieren" Width="140" Height="28"
                    Margin="0,0,8,0" Click="btnThemaKopieren_Click"
                    ToolTip="Kopiert das angezeigte Thema in die Zwischenablage. Einzelne Abschnitte lassen sich auch direkt markieren und mit Strg+C kopieren."/>
            <Button x:Name="btnAlsTextSpeichern" Content="Als Textdatei speichern" Width="170" Height="28"
                    Margin="0,0,8,0" Click="btnAlsTextSpeichern_Click"/>
            <Button Content="Schließen" Width="100" Height="28" IsCancel="True"
                    Click="btnSchliessen_Click"/>
        </StackPanel>
    </Grid>
</Window>
