<Window x:Class="Listenverschieber.KonfliktDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚠ Dateikonflikt" Height="480" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status: Identisch oder Unterschiedlich -->
        <Border Grid.Row="0" x:Name="brdStatus" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <TextBlock x:Name="txtStatus" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>

        <!-- Quelldatei -->
        <GroupBox Grid.Row="1" Header="📄 Quelldatei (wird kopiert/verschoben)" Margin="0,0,0,5">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Datei:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtQuellDatei" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Pfad:" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtQuellPfad" TextTrimming="CharacterEllipsis" Foreground="Gray"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Größe:" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtQuellGroesse"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Hash:" Margin="0,0,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtQuellHash" FontFamily="Consolas" FontSize="11"/>
            </Grid>
        </GroupBox>

        <!-- Zieldatei -->
        <GroupBox Grid.Row="2" Header="📄 Zieldatei (existiert bereits)" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Datei:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtZielDatei" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Pfad:" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtZielPfad" TextTrimming="CharacterEllipsis" Foreground="Gray"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Größe:" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtZielGroesse"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Hash:" Margin="0,0,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtZielHash" FontFamily="Consolas" FontSize="11"/>
            </Grid>
        </GroupBox>

        <!-- Aktionen -->
        <GroupBox Grid.Row="3" Header="Aktion wählen" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Row="0" Grid.Column="0" Content="⏭ Überspringen" Click="BtnUeberspringen_Click" Height="32" Margin="0,0,3,5" ToolTip="Datei nicht kopieren/verschieben"/>
                <Button Grid.Row="0" Grid.Column="1" Content="📝 Überschreiben" Click="BtnUeberschreiben_Click" Height="32" Margin="3,0,0,5" ToolTip="Zieldatei mit Quelldatei überschreiben"/>
                <Button Grid.Row="1" Grid.Column="0" x:Name="btnQuelleUmbenennen" Click="BtnQuelleUmbenennen_Click" Height="32" Margin="0,0,3,0" ToolTip="Quelldatei mit Hash-Suffix ins Ziel kopieren/verschieben"/>
                <Button Grid.Row="1" Grid.Column="1" x:Name="btnZielUmbenennen" Click="BtnZielUmbenennen_Click" Height="32" Margin="3,0,0,0" ToolTip="Bestehende Zieldatei umbenennen, Quelldatei übernimmt den Originalnamen"/>
            </Grid>
        </GroupBox>

        <!-- Für alle anwenden -->
        <CheckBox Grid.Row="4" x:Name="chkFuerAlle" Content="✓ Für alle weiteren Konflikte genauso verfahren" 
                  FontWeight="Bold" Margin="0,0,0,0"/>
    </Grid>
</Window>
